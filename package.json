{
  "name": "streamscope",
  "version": "0.1.1",
  "description": "Black-box recorder, frame-level replayer and deterministic fault injector for AI streaming UIs (SSE / NDJSON / AI SDK / AG-UI).",
  "keywords": [
    "ai",
    "streaming",
    "sse",
    "ndjson",
    "ag-ui",
    "vercel-ai-sdk",
    "debugging",
    "record-replay",
    "fault-injection",
    "playwright",
    "llm",
    "developer-tools"
  ],
  "author": "jungingwon (developjik)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/developjik/streamscope.git"
  },
  "homepage": "https://github.com/developjik/streamscope#readme",
  "bugs": {
    "url": "https://github.com/developjik/streamscope/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "streamscope": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "import": "./dist/playwright.js"
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./cypress": {
      "types": "./dist/cypress.d.ts",
      "import": "./dist/cypress.js"
    }
  },
  "files": [
    "dist",
    "demo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node e2e/run-e2e.mjs && node e2e/runner-fixtures.mjs",
    "demo": "node demo/server.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "playground:build": "vite build --config apps/playground/vite.config.mjs",
    "playground:dev": "vite --config apps/playground/vite.config.mjs",
    "playground:typecheck": "tsc -p apps/playground/tsconfig.json",
    "test:playground": "node e2e/playground.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "playwright": "^1.65.1",
    "playwright-core": "^1.65.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
